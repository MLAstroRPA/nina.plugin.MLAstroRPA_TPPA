<UserControl x:Class="MLAstro_Robotic_Polar_Alignment.Dockables.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Force Stop Button Style with Press Effect -->
        <Style x:Key="ForceStopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="DarkRed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B22222"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CD5C5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0000"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset Error Button Style with Press Effect (shown only in ERROR state) -->
        <Style x:Key="ResetErrorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B8860B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#8B6914"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DAA520"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF8C00"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- HEADER - Fixed at top (shared across Navigation & Config tabs) -->
    <Border Background="#2C3E50" 
            Padding="10,8"
            BorderBrush="#34495E"
            BorderThickness="0,0,0,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="pack://application:,,,/NINA.Plugins.PolarAlignment;component/MLAstroRPA-navigation/Resources/MLAstro_logo.png"
                       Width="72"
                       Height="72"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MLAstro RPA" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Robotic Polar Alignment" 
                               FontSize="11" 
                               Foreground="#BDC3C7"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware {0}}" 
                               FontSize="11" 
                               Foreground="#BDC3C7"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Status:" 
                               Foreground="#BDC3C7" 
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemStatus}" 
                               FontWeight="Bold"
                               Foreground="{Binding StatusForeground}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Connection:" 
                               Foreground="#BDC3C7" 
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="12" 
                             Height="12" 
                             Fill="{Binding ConnectionStatusColor}"
                             ToolTip="{Binding ConnectionStatusText}"/>
                </StackPanel>
            </StackPanel>

            <!-- Force Stop Button in Header -->
            <Button Grid.Column="2" 
                    Style="{StaticResource ForceStopButtonStyle}"
                    Width="80" 
                    Height="45"
                    FontSize="11"
                    ToolTip="FORCE STOP (Emergency)"
                    Command="{Binding ForceStopCommand}">
                <TextBlock Text="FORCE&#x0a;STOP" TextAlignment="Center"/>
            </Button>

            <!-- Reset Error Button in Header (only visible when STATUS = ERROR) -->
            <Button Grid.Column="3"
                    Style="{StaticResource ResetErrorButtonStyle}"
                    Width="85"
                    Height="45"
                    FontSize="11"
                    Margin="8,0,0,0"
                    ToolTip="RESET ERROR - clears driver error (sends ReEr:1)"
                    Visibility="{Binding ResetErrorButtonVisibility}"
                    Command="{Binding ResetErrorCommand}">
                <TextBlock Text="RESET&#x0a;ERROR" TextAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
