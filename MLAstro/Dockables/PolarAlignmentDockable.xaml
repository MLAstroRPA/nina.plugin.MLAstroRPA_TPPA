<UserControl x:Class="MLAstro_Robotic_Polar_Alignment.Dockables.PolarAlignmentDockable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MLAstro_Robotic_Polar_Alignment.Converters"
             PreviewMouseMove="OnDockPreviewMouseMove">

    <UserControl.Resources>
        <converters:SpeedLevelToBoolConverter x:Key="SpeedLevelToBoolConverter"/>

        <!-- Speed Button Style -->
        <Style x:Key="SpeedButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selected state styling via DataTrigger -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SpeedLevelToBoolConverter}">
                            <Binding Path="CurrentSpeed"/>
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Movement Button Style with Press Effect -->
        <Style x:Key="MovementButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#5D6D7E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A6278"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7F8C8D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2ECC71"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#27AE60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button Style with Press Effect -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Background" Value="OrangeRed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E74C3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DirectionToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#4A4F55"/>
            <Setter Property="BorderBrush" Value="#4A4F55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Fill="#111111"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3498DB"/>
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- CONTENT - Scrollable -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Loaded="OnDockScrollViewerLoaded"
                      PreviewMouseWheel="OnDockScrollViewerPreviewMouseWheel">
            <StackPanel Margin="10">

            <!-- Disconnected notice (shown only when there is no serial connection) -->
            <TextBlock Text="⚠️ Not connected&#10;&#10;Open the CONFIGURATION tab and connect to the MLAstro RPA hardware via serial port to start controlling."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#F39C12"
                       Margin="0,20,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ControlsVisibility}" Value="Collapsed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Manual Movement Control -->
            <Expander Header="🕹️ Manual Movement" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Speed Level -->
                    <TextBlock Text="Speed Level:" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <WrapPanel Margin="0,0,0,15" HorizontalAlignment="Center">
                        <Button Content="1" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="1" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="2" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="2" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="3" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="3" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="4" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="4" IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="5" Style="{StaticResource SpeedButtonStyle}" Command="{Binding SetSpeedCommand}" CommandParameter="5" IsEnabled="{Binding CanManualControl}"/>
                    </WrapPanel>

                    <!-- Control Mode Toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock Text="Jog (Hold)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox IsChecked="{Binding IsRelativeMode, Mode=TwoWay}" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,10,0"
                                  IsEnabled="{Binding CanManualControl}"/>
                        <TextBlock Text="Relative (Step)" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Relative Steps (visible only in Relative mode) -->
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,15"
                            Visibility="{Binding RelativeOptionsVisibility}"
                            HorizontalAlignment="Center">
                        <WrapPanel>
                            <!-- Degrees -->
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Degrees" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeDegreesDecDown" 
                                            PreviewMouseUp="OnRelativeDegreesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBlock Text="{Binding RelativeDegrees}" 
                                               Width="40" 
                                               TextAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="5,0"/>
                                    <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeDegreesIncDown" 
                                            PreviewMouseUp="OnRelativeDegreesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Minutes -->
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Minutes" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeMinutesDecDown" 
                                            PreviewMouseUp="OnRelativeMinutesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBlock Text="{Binding RelativeMinutes}" 
                                               Width="40" 
                                               TextAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="5,0"/>
                                    <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeMinutesIncDown" 
                                            PreviewMouseUp="OnRelativeMinutesButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Seconds -->
                            <StackPanel>
                                <TextBlock Text="Seconds" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" 
                                            PreviewMouseDown="OnRelativeSecondsDecDown" 
                                            PreviewMouseUp="OnRelativeSecondsButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                    <TextBlock Text="{Binding RelativeSeconds}" 
                                               Width="40" 
                                               TextAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="5,0"/>
                                    <TextBlock Text='"' VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="30" 
                                            PreviewMouseDown="OnRelativeSecondsIncDown" 
                                            PreviewMouseUp="OnRelativeSecondsButtonUp"
                                            IsEnabled="{Binding CanManualControl}"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Directional Pad -->
                    <Grid Width="280" Height="280" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <!-- Up Button -->
                        <Button Content="▲ Alt" 
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                PreviewMouseDown="OnMoveUpDown"
                                PreviewMouseUp="OnMoveUpUp"
                                MouseLeave="OnMoveUpUp"
                                IsEnabled="{Binding CanManualControl}"/>

                        <!-- Left Button -->
                        <Button Content="◄ Az" 
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                PreviewMouseDown="OnMoveLeftDown"
                                PreviewMouseUp="OnMoveLeftUp"
                                MouseLeave="OnMoveLeftUp"
                                IsEnabled="{Binding CanManualControl}"/>

                        <!-- Stop Button -->
                        <Button Content="⏹ STOP" 
                                Style="{StaticResource StopButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding StopCommand}"/>

                        <!-- Right Button -->
                        <Button Content="► Az" 
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                PreviewMouseDown="OnMoveRightDown"
                                PreviewMouseUp="OnMoveRightUp"
                                MouseLeave="OnMoveRightUp"
                                IsEnabled="{Binding CanManualControl}"/>

                        <!-- Down Button -->
                        <Button Content="▼ Alt" 
                                Style="{StaticResource MovementButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                PreviewMouseDown="OnMoveDownDown"
                                PreviewMouseUp="OnMoveDownUp"
                                MouseLeave="OnMoveDownUp"
                                IsEnabled="{Binding CanManualControl}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Position Display -->
            <Expander Header="📐 Position" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Azimuth Position -->
                    <TextBlock Text="Azimuth (from home):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding AzPosition}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                    <!-- Altitude Position -->
                    <TextBlock Text="Altitude (from home):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBlock Text="{Binding AltPosition}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                    <!-- Homed Status -->
                    <TextBlock Margin="0,15,0,10">
                        <Run Text="🏠 Homed:"/>
                        <Run Text="{Binding HomedStatus}" FontWeight="Bold"/>
                    </TextBlock>

                    <!-- Home Buttons -->
                    <WrapPanel Margin="0,0,0,0">
                        <Button Content="🏠 SET HOME HERE" 
                                Width="150" 
                                Margin="0,0,5,5"
                                Command="{Binding SetHomeCommand}"
                                IsEnabled="{Binding CanManualControl}"/>
                        <Button Content="↻ RETURN TO HOME" 
                                Width="150" 
                                Margin="0,0,5,5"
                                Command="{Binding ReturnHomeCommand}"
                            IsEnabled="{Binding CanAutomaticControl}"/>
                        <Button Content="⚠️ RESET HOME" 
                                Width="150" 
                                Margin="0,0,5,5"
                                Background="DarkOrange"
                                Foreground="White"
                                Command="{Binding ResetHomeCommand}"
                                IsEnabled="{Binding CanManualControl}"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Polar Alignment -->
            <Expander Header="🎯 Polar Alignment" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding ControlsVisibility}">
                <StackPanel Margin="10">
                    <!-- Moved Position Display -->
                    <Border Background="#2C3E50" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Az Moved -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Az Moved" 
                                           FontSize="11" 
                                           Foreground="#BDC3C7" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AzMovedPosition}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Alt Moved -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Alt Moved" 
                                           FontSize="11" 
                                           Foreground="#BDC3C7" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AltMovedPosition}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Az Error Input -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Az Error:" FontWeight="SemiBold" Margin="0,0,15,5"/>
                        <WrapPanel Grid.Column="1" Grid.Row="0" Margin="0,0,20,5">
                            <TextBox Text="{Binding AzErrorDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AzErrorMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AzErrorSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text='"' VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding AzErrorRight, Mode=TwoWay}" Style="{StaticResource DirectionToggleStyle}" VerticalAlignment="Center" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Grid.RowSpan="2" Content="Align Az" Width="100" VerticalAlignment="Center" Command="{Binding AlignAzCommand}" IsEnabled="{Binding CanAlign}"/>
                    </Grid>

                    <Border Height="1" Background="#3A4654" Opacity="0.55" Margin="0,0,0,15"/>

                    <!-- Alt Error Input -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alt Error:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBox Text="{Binding AltErrorDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AltErrorMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text="'" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding AltErrorSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,5,0" GotKeyboardFocus="OnAlignmentInputGotFocus"/>
                            <TextBlock Text='"' VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Up" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <CheckBox IsChecked="{Binding AltErrorUp, Mode=TwoWay}"
                                      Style="{StaticResource DirectionToggleStyle}"
                                      HorizontalAlignment="Center"
                                      GotKeyboardFocus="OnAlignmentInputGotFocus">
                                <CheckBox.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                            <TextBlock Text="Down" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Align Alt" Width="100" VerticalAlignment="Center" Command="{Binding AlignAltCommand}" IsEnabled="{Binding CanAlign}"/>
                    </Grid>

                    <!-- Align All Button -->
                    <Button Content="✓ ALIGN ALL" 
                            Height="40"
                            Background="Green"
                            Foreground="White"
                            IsEnabled="{Binding CanAlign}"
                            FontWeight="Bold"
                            FontSize="16"
                            Command="{Binding AlignAllCommand}"/>
                </StackPanel>
            </Expander>

            <!-- Alarm History (industrial HMI style): only ERROR/WARNING codes are shown; each row
                 carries the activation time and, once cleared, the end time on the SAME row. -->
            <Expander Header="⚠️ Alarm History" IsExpanded="True" Margin="0,0,0,10"
                      Visibility="{Binding AlarmHistoryVisibility}">
                <StackPanel Margin="6">
                    <DataGrid ItemsSource="{Binding AlarmHistory}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Background="#1E272E"
                              Foreground="White"
                              BorderBrush="#3A4654"
                              BorderThickness="1"
                              FontSize="12"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Severity" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeverityText}"
                                                   Foreground="{Binding SeverityBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Activated" Binding="{Binding ActivatedText}" Width="80"/>
                            <DataGridTextColumn Header="Cleared" Binding="{Binding ClearedText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
